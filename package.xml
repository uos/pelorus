  <version>0.0.7</version>
  <description>Pelorus ROS2</description>
  <maintainer email="stelzo@steado.de">stelzo</maintainer>
  <license>MIT</license>
  <author>stelzo</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>python3-catkin-pkg-modules</build_depend>
