<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format2.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="2">
  <name>pelorus</name>
  <version>0.0.6</version>
  <description>Pelorus ROS2</description>
  <maintainer email="stelzo@steado.de">Christopher Sieh</maintainer>
  <license>MIT</license>
  <author>Christopher Sieh</author>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>python3-catkin-pkg-modules</build_depend>
  <build_depend>libclang-dev</build_depend>

  <build_depend>rcl</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>tf2_msgs</build_depend>
  <build_depend>visualization_msgs</build_depend>

  <exec_depend>rcl</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>


  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
