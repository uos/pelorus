#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 0) readonly buffer InputPoints { Point input_points[]; };
layout(std430, set = 0, binding = 1) buffer SelectedPoints { Point selected_points[]; };
layout(std430, set = 0, binding = 2) buffer Keys { int keys[]; };
layout(std430, set = 0, binding = 3) buffer Indices { uint indices[]; };
layout(std430, set = 0, binding = 4) readonly buffer UniqueKeys { int unique_keys[]; };
layout(std430, set = 0, binding = 6) readonly buffer RunStarts { uint run_starts[]; };
layout(std430, set = 0, binding = 7) readonly buffer RunEnds { uint run_ends[]; };
layout(std430, set = 0, binding = 10) readonly buffer Counters {
    uint unique_count;
    uint add_cursor;
    uint lru_cursor;
};
layout(std430, set = 0, binding = 15) buffer Medoids { Point medoids[]; };

// Rust evaluates the CPU medoid distance as separate f32 subtractions,
// multiplies and adds, left to right. `precise` keeps the compiler from
// contracting them into FMAs, which breaks exact distance ties and picks a
// different point than the CPU.
float squared_distance_cpu_order(Point p, vec3 center) {
    precise float dx = p.x - center.x;
    precise float dy = p.y - center.y;
    precise float dz = p.z - center.z;
    precise float dist = (dx * dx + dy * dy) + dz * dz;
    return dist;
}

bool point_lexicographically_less(Point lhs, Point rhs) {
    if (lhs.t != rhs.t) return lhs.t < rhs.t;
    if (lhs.x != rhs.x) return lhs.x < rhs.x;
    if (lhs.y != rhs.y) return lhs.y < rhs.y;
    if (lhs.z != rhs.z) return lhs.z < rhs.z;
    return lhs.i < rhs.i;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;

#ifdef BUILD_KEYS
    if (idx >= pc.n) {
        return;
    }

    uint src_idx = idx * max(pc.cap, 1u);
    Point p = input_points[src_idx];
    selected_points[idx] = p;

    ivec3 grid = grid_pos(pc.resolution, vec3(p.x, p.y, p.z));
    keys[idx] = hash_grid(grid) ^ 0x80000000;
    indices[idx] = idx;
#endif

#ifdef MEDOIDS
    // `dispatch` rounds the grid up to whole workgroups, so invocations run past
    // `pc.n`. The sentinel store below must not reach them: `medoids` is only
    // guaranteed to cover `pc.n`, and for a cloud smaller than a workgroup its
    // whole allocation sits inside the rounded-up range.
    if (idx >= pc.n) {
        return;
    }

    if (idx >= unique_count) {
        Point invalid;
        invalid.x = 0.0;
        invalid.y = 0.0;
        invalid.z = 0.0;
        invalid.i = 0.0;
        invalid.t = uintBitsToFloat(0x7F800000u);
        medoids[idx] = invalid;
        return;
    }

    uint start = run_starts[idx];
    uint end = run_ends[idx];
    if (end <= start) {
        return;
    }

    precise vec3 sum = vec3(0.0);
    for (uint i = start; i < end; i++) {
        Point p = selected_points[indices[i]];
        sum += vec3(p.x, p.y, p.z);
    }

    precise vec3 center = sum / float(end - start);
    Point best = selected_points[indices[start]];
    float best_dist = squared_distance_cpu_order(best, center);
    for (uint i = start + 1u; i < end; i++) {
        Point p = selected_points[indices[i]];
        float dist = squared_distance_cpu_order(p, center);
        if (dist < best_dist || (dist == best_dist && point_lexicographically_less(p, best))) {
            best_dist = dist;
            best = p;
        }
    }

    medoids[idx] = best;
#endif

#ifdef TIMESTAMP_KEYS
    if (idx >= pc.n) {
        return;
    }

    Point p = selected_points[indices[idx]];
    if (pc.j == 5u) {
        ivec3 grid = grid_pos(pc.resolution, vec3(p.x, p.y, p.z));
        keys[idx] = hash_grid(grid) ^ int(0x80000000u);
        return;
    }

    float value = p.t;
    if (pc.j == 1u) value = p.x;
    if (pc.j == 2u) value = p.y;
    if (pc.j == 3u) value = p.z;
    if (pc.j == 4u) value = p.i;

    keys[idx] = int(floatBitsToUint(value));
#endif
}
