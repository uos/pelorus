#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 9) readonly buffer DistBuf {
    VoxelDistribution voxels[];
};
layout(std430, set = 0, binding = 2) writeonly buffer LruKeys { uint lru_keys[]; };
layout(std430, set = 0, binding = 11) writeonly buffer LruVals { uint lru_vals[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.dist_cap) return;

    uint pt_count = voxels[i].point_count;
    uint last_scan = voxels[i].last_scan;
    // Guard against underflow: if last_scan > scan_number, treat as 0
    uint temporal_dist = (pc.scan_number >= last_scan) ? (pc.scan_number - last_scan) : 0u;

    // Match CUDA semantics:
    // score = temporal_dist / point_count, empty voxels = huge score, then sort by score descending.
    // Radix sort here is ascending, so invert bits to emulate descending order.
    float score = (pt_count == 0u) ? 1e20 : (float(temporal_dist) / float(pt_count));
    lru_keys[i] = ~floatBitsToUint(score);
    lru_vals[i] = i;
}
