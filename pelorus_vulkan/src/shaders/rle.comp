#version 450

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 2) readonly buffer SortedKeys { int sorted_keys[]; };
layout(std430, set = 0, binding = 4) writeonly buffer UniqueKeys { int unique_keys[]; };
layout(std430, set = 0, binding = 6) writeonly buffer RunStarts { uint run_starts[]; };
layout(std430, set = 0, binding = 7) writeonly buffer RunEnds { uint run_ends[]; };
layout(std430, set = 0, binding = 10) buffer Counters {
    uint unique_count;
    uint add_cursor;
    uint lru_cursor;
};

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    int key = int(uint(sorted_keys[i]) ^ 0x80000000u); // Convert back from unsigned-order
    if (key == EMPTY_KEY) return;

    bool is_start = (i == 0) || (int(uint(sorted_keys[i - 1]) ^ 0x80000000u) != key);
    if (is_start) {
        uint left = i;
        uint right = pc.n;
        while (left < right) {
            uint mid = left + (right - left) / 2;
            if (int(uint(sorted_keys[mid]) ^ 0x80000000u) <= key) {
                left = mid + 1;
            } else {
                right = mid;
            }
        }
        uint end = left;

        uint idx = atomicAdd(unique_count, 1);
        run_starts[idx] = i;
        run_ends[idx] = end;
        unique_keys[idx] = key;
    }
}
