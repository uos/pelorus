vec3 quat_rotate(vec4 q, vec3 v) {
    vec3 u = q.xyz;
    vec3 t = 2.0 * cross(u, v);
    return v + q.w * t + cross(u, t);
}

vec3 iso_transform(vec4 quat, vec3 trans, vec3 point) {
    return quat_rotate(quat, point) + trans;
}

ivec3 grid_pos(float resolution, vec3 p) {
    float inv = 1.0 / resolution;
    return ivec3(
        int(floor(p.x * inv)),
        int(floor(p.y * inv)),
        int(floor(p.z * inv))
    );
}

int hash_grid(ivec3 g) {
    return (g.x * 73856093) + (g.y * 471943) + (g.z * 83492791);
}

uint hash_fn(int key) {
    uint h = uint(key);
    h ^= h >> 16;
    h *= 0x85ebca6bu;
    h ^= h >> 13;
    h *= 0xc2b2ae35u;
    h ^= h >> 16;
    return h;
}

bool cholesky_3x3(in float A[9], out float L[9]) {
    for (int i = 0; i < 9; i++) {
        L[i] = 0.0;
    }

    float l00_sq = A[0];
    if (l00_sq <= 0.0) {
        return false;
    }
    float l00 = sqrt(l00_sq);
    L[0] = l00;

    L[3] = A[3] / l00;
    L[6] = A[6] / l00;

    float l11_sq = A[4] - L[3] * L[3];
    if (l11_sq <= 0.0) {
        return false;
    }
    float l11 = sqrt(l11_sq);
    L[4] = l11;

    L[7] = (A[7] - L[6] * L[3]) / l11;

    float l22_sq = A[8] - (L[6] * L[6] + L[7] * L[7]);
    if (l22_sq <= 0.0) {
        return false;
    }
    L[8] = sqrt(l22_sq);
    return true;
}

vec3 cholesky_solve_3x3(in float L[9], vec3 b) {
    vec3 y;
    y.x = b.x / L[0];
    y.y = (b.y - L[3] * y.x) / L[4];
    y.z = (b.z - L[6] * y.x - L[7] * y.y) / L[8];

    vec3 x;
    x.z = y.z / L[8];
    x.y = (y.y - L[7] * x.z) / L[4];
    x.x = (y.x - L[3] * x.y - L[6] * x.z) / L[0];
    return x;
}

float mahalanobis_sq(vec3 diff, in float L[9]) {
    vec3 sol = cholesky_solve_3x3(L, diff);
    return dot(diff, sol);
}

void regularize_cov(inout float cov[9]) {
    cov[0] += 1e-6;
    cov[4] += 1e-6;
    cov[8] += 1e-6;
}

vec3 symmetric_eigen_3x3(in float A[9]) {
    float a00 = A[0];
    float a01 = A[1];
    float a02 = A[2];
    float a11 = A[4];
    float a12 = A[5];
    float a22 = A[8];

    float traceA = a00 + a11 + a22;
    float c2 = (a00 * a11 + a00 * a22 + a11 * a22) - (a01 * a01 + a02 * a02 + a12 * a12);
    float detA = a00 * (a11 * a22 - a12 * a12) - a01 * (a01 * a22 - a12 * a02) + a02 * (a01 * a12 - a11 * a02);

    float p = -traceA;
    float q = c2;
    float r = -detA;

    float a_d = (3.0 * q - p * p) / 3.0;
    float b_d = (2.0 * p * p * p - 9.0 * p * q + 27.0 * r) / 27.0;

    float angle = 0.0;
    if (a_d != 0.0) {
        float arg = (-b_d / 2.0) / sqrt(-a_d * a_d * a_d / 27.0);
        arg = clamp(arg, -1.0, 1.0);
        angle = acos(arg);
    }

    float two_s = 2.0 * sqrt(-a_d / 3.0);
    float p3 = p / 3.0;
    float pi2 = 6.28318530718;

    return vec3(
        two_s * cos(angle / 3.0) - p3,
        two_s * cos((angle + pi2) / 3.0) - p3,
        two_s * cos((angle + 2.0 * pi2) / 3.0) - p3
    );
}

uint neighbor_cells(uint nbtype, ivec3 g, out ivec3 out_cells[27]) {
    if (nbtype == 6u) {
        out_cells[0] = g;
        out_cells[1] = g + ivec3(-1, 0, 0);
        out_cells[2] = g + ivec3(1, 0, 0);
        out_cells[3] = g + ivec3(0, 1, 0);
        out_cells[4] = g + ivec3(0, -1, 0);
        out_cells[5] = g + ivec3(0, 0, -1);
        out_cells[6] = g + ivec3(0, 0, 1);
        return 7u;
    }
    if (nbtype == 18u) {
        out_cells[0] = g;
        out_cells[1] = g + ivec3(-1, 0, 0); out_cells[2] = g + ivec3(1, 0, 0);
        out_cells[3] = g + ivec3(0, 1, 0); out_cells[4] = g + ivec3(0, -1, 0);
        out_cells[5] = g + ivec3(0, 0, -1); out_cells[6] = g + ivec3(0, 0, 1);
        out_cells[7] = g + ivec3(1, 1, 0); out_cells[8] = g + ivec3(-1, 1, 0);
        out_cells[9] = g + ivec3(1, -1, 0); out_cells[10] = g + ivec3(-1, -1, 0);
        out_cells[11] = g + ivec3(1, 0, 1); out_cells[12] = g + ivec3(-1, 0, 1);
        out_cells[13] = g + ivec3(1, 0, -1); out_cells[14] = g + ivec3(-1, 0, -1);
        out_cells[15] = g + ivec3(0, 1, 1); out_cells[16] = g + ivec3(0, -1, 1);
        out_cells[17] = g + ivec3(0, 1, -1); out_cells[18] = g + ivec3(0, -1, -1);
        return 19u;
    }

    out_cells[0] = g;
    out_cells[1] = g + ivec3(-1, 0, 0); out_cells[2] = g + ivec3(1, 0, 0);
    out_cells[3] = g + ivec3(0, 1, 0); out_cells[4] = g + ivec3(0, -1, 0);
    out_cells[5] = g + ivec3(0, 0, -1); out_cells[6] = g + ivec3(0, 0, 1);
    out_cells[7] = g + ivec3(1, 1, 0); out_cells[8] = g + ivec3(-1, 1, 0);
    out_cells[9] = g + ivec3(1, -1, 0); out_cells[10] = g + ivec3(-1, -1, 0);
    out_cells[11] = g + ivec3(1, 0, 1); out_cells[12] = g + ivec3(-1, 0, 1);
    out_cells[13] = g + ivec3(1, 0, -1); out_cells[14] = g + ivec3(-1, 0, -1);
    out_cells[15] = g + ivec3(0, 1, 1); out_cells[16] = g + ivec3(0, -1, 1);
    out_cells[17] = g + ivec3(0, 1, -1); out_cells[18] = g + ivec3(0, -1, -1);
    out_cells[19] = g + ivec3(1, 1, 1); out_cells[20] = g + ivec3(-1, 1, 1);
    out_cells[21] = g + ivec3(1, -1, 1); out_cells[22] = g + ivec3(1, 1, -1);
    out_cells[23] = g + ivec3(-1, -1, 1); out_cells[24] = g + ivec3(-1, 1, -1);
    out_cells[25] = g + ivec3(1, -1, -1); out_cells[26] = g + ivec3(-1, -1, -1);
    return 27u;
}

void pool_dist(inout uint acc_point_count, inout float acc_mean[3], inout float acc_cov[9], VoxelDistribution other) {
    if (other.point_count == 0u) {
        return;
    }

    if (acc_point_count == 0u) {
        acc_point_count = other.point_count;
        acc_mean[0] = other.mean[0];
        acc_mean[1] = other.mean[1];
        acc_mean[2] = other.mean[2];
        for (int i = 0; i < 9; i++) {
            acc_cov[i] = other.cov[i];
        }
        return;
    }

    float n1 = float(acc_point_count);
    float n2 = float(other.point_count);
    float total_points = n1 + n2;

    vec3 mean1 = vec3(acc_mean[0], acc_mean[1], acc_mean[2]);
    vec3 mean2 = vec3(other.mean[0], other.mean[1], other.mean[2]);
    vec3 new_mean = (n1 * mean1 + n2 * mean2) / total_points;

    vec3 delta = mean1 - mean2;
    float delta_weight = (n1 * n2 / total_points);

    for (int r = 0; r < 3; r++) {
        for (int c = 0; c < 3; c++) {
            float c1 = acc_cov[r * 3 + c];
            float c2 = other.cov[r * 3 + c];
            acc_cov[r * 3 + c] = (n1 * c1 + n2 * c2 + delta[r] * delta[c] * delta_weight) / total_points;
        }
    }

    acc_mean[0] = new_mean.x;
    acc_mean[1] = new_mean.y;
    acc_mean[2] = new_mean.z;
    acc_point_count = uint(total_points);
}
