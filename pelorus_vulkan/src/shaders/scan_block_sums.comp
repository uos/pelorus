#version 450

// Prefix sum of block sums (single workgroup)
// Second pass: compute exclusive prefix sum of block sums

layout(local_size_x = 256) in;

layout(std430, set = 0, binding = 17) buffer BlockSums { uint block_sums[]; };

shared uint shared_data[512];

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint group_size = gl_WorkGroupSize.x;

    uint idx1 = lid;
    uint idx2 = lid + group_size;

    // Load block sums into shared memory
    // Note: we treat block_sums as both input and output
    shared_data[lid] = block_sums[idx1];
    shared_data[lid + group_size] = (idx2 < 1024u) ? block_sums[idx2] : 0u;

    barrier();

    // Upsweep
    uint offset = 1u;
    for (uint d = group_size; d > 0u; d >>= 1u) {
        if (lid < d) {
            uint ai = offset * (2u * lid + 1u) - 1u;
            uint bi = offset * (2u * lid + 2u) - 1u;
            shared_data[bi] += shared_data[ai];
        }
        barrier();
        offset *= 2u;
    }

    // Clear last element
    if (lid == 0u) {
        shared_data[2u * group_size - 1u] = 0u;
    }

    barrier();

    // Downsweep
    for (uint d = 1u; d < 2u * group_size; d *= 2u) {
        offset >>= 1u;
        barrier();
        if (lid < d) {
            uint ai = offset * (2u * lid + 1u) - 1u;
            uint bi = offset * (2u * lid + 2u) - 1u;
            uint t = shared_data[ai];
            shared_data[ai] = shared_data[bi];
            shared_data[bi] += t;
        }
    }

    barrier();

    // Write results back to block_sums
    block_sums[idx1] = shared_data[lid];
    if (idx2 < 1024u) block_sums[idx2] = shared_data[lid + group_size];
}
