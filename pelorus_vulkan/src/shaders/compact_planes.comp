#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(std430, set = 0, binding = 15) readonly buffer CandidatePlanes { PointNormal candidates[]; };
layout(std430, set = 0, binding = 16) readonly buffer PlaneOffsets { uint offsets[]; };
layout(std430, set = 0, binding = 17) writeonly buffer CompactPlanes { PointNormal compact[]; };

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.n) {
        return;
    }

    PointNormal p = candidates[idx];
    if (p.nx == 0.0 && p.ny == 0.0 && p.nz == 0.0) {
        return;
    }

    compact[offsets[idx]] = p;
}
