// The host prepends the common point types and push constants after extensions.
layout(local_size_x = 256) in;
struct MRCell {
  ivec3 key;
  uint scan;
  uint64_t count;
  float mean[3];
  float cov[9];
};
struct MRFit {
  uint status;
  float mean[3];
  float normal[3];
  float tangent[6];
  float extent[2];
  float quality;
  float d;
};
