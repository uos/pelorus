#endif
layout(scalar, set = 0, binding = 4) readonly buffer Level0 { MRCell cells0[]; };
layout(scalar, set = 0, binding = 5) readonly buffer Level1 { MRCell cells1[]; };
layout(scalar, set = 0, binding = 6) readonly buffer Level2 { MRCell cells2[]; };
layout(scalar, set = 0, binding = 7) readonly buffer Level3 { MRCell cells3[]; };
