# Uninstall script for Pelorus (generated by CMake)

if(NOT EXISTS "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
  message(FATAL_ERROR "Cannot find install_manifest.txt in: @CMAKE_CURRENT_BINARY_DIR@\nRun install first (make install) to generate it.")
endif()

file(READ "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt" _manifest)

# One path per line
string(REPLACE "\n" ";" _files "${_manifest}")

foreach(_file IN LISTS _files)
  if(_file STREQUAL "")
    continue()
  endif()

  message(STATUS "Uninstalling: ${_file}")

  if(EXISTS "${_file}" OR IS_SYMLINK "${_file}")
    execute_process(
      COMMAND "@CMAKE_COMMAND@" -E rm -f "${_file}"
      RESULT_VARIABLE _rm_result
      OUTPUT_QUIET
      ERROR_QUIET
    )

    if(NOT _rm_result EQUAL 0)
      message(WARNING "Failed to remove: ${_file}")
    endif()
  else()
    message(STATUS "Already removed: ${_file}")
  endif()
endforeach()
